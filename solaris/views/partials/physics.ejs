<section class="solaris-section solaris-physics" id="technology">
  <div class="solaris-container">
    <div class="solaris-physics-grid">
      <div class="solaris-physics-copy">
        <p class="solaris-eyebrow">THE PHYSICS</p>
        <h2 class="solaris-section-title">Two equations govern the entire simulation.</h2>
        <p class="solaris-section-sub">
          Irradiance received by the panel depends only on the angle between the incoming sunlight
          and the panel's surface normal. Power output then scales that irradiance by the panel's
          area and conversion efficiency.
        </p>
        <ul class="solaris-var-list">
          <li><span>I<sub>sun</sub></span> — available solar irradiance (W/m²)</li>
          <li><span>θ</span> — incidence angle between sunlight and panel normal</li>
          <li><span>A</span> — panel surface area (m²)</li>
          <li><span>η</span> — panel conversion efficiency</li>
        </ul>
      </div>
      <div class="solaris-physics-formula">
        <div class="solaris-formula-card">
          <p class="solaris-formula-label">Irradiance</p>
          <p class="solaris-formula">I_received = I_sun × cos(θ)</p>
        </div>
        <div class="solaris-formula-card">
          <p class="solaris-formula-label">Power</p>
          <p class="solaris-formula">P = I × A × η</p>
        </div>
      </div>
    </div>
  </div>
</section>
