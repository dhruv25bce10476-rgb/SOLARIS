<section class="solaris-section solaris-comparison">
  <div class="solaris-container">
    <div class="solaris-section-head">
      <p class="solaris-eyebrow">PERFORMANCE COMPARISON</p>
      <h2 class="solaris-section-title">Fixed panel vs. tracking panel.</h2>
      <p class="solaris-section-sub">Simulated results accumulate live as the day progresses.</p>
    </div>

    <div class="solaris-comparison-grid">
      <div class="solaris-comparison-card">
        <p class="solaris-comparison-label">FIXED PANEL</p>
        <p class="solaris-comparison-value" id="compareFixedValue">0.00 kWh</p>
        <p class="solaris-comparison-caption">Energy generated at a stationary orientation.</p>
      </div>

      <div class="solaris-comparison-card solaris-comparison-card-highlight">
        <p class="solaris-comparison-label">TRACKING PANEL</p>
        <p class="solaris-comparison-value" id="compareTrackValue">0.00 kWh</p>
        <p class="solaris-comparison-caption">Energy generated while continuously optimizing orientation.</p>
      </div>
    </div>

    <div class="solaris-comparison-gain">
      <span class="solaris-gain-badge" id="compareGainBadge">+0.0% more energy</span>
    </div>
  </div>
</section>
